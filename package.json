{
  "name": "prometheus-browser",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.22.2 <25" },
  "scripts": {
    "test": "node --test --test-concurrency=2 tests/integration/*.test.mjs",
    "test:controller": "npm --prefix packages/prometheus test",
    "test:controller:native": "npm --prefix packages/prometheus run test:native",
    "browser": "node scripts/browser-profile.mjs"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "playwright": "1.63.0"
  }
}
