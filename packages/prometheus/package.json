{
  "name": "opencode-prometheus",
  "version": "0.2.0",
  "description": "Native OpenCode V2 investigation, decisions, and independent verification.",
  "type": "module",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": { "node": ">=22.22.2 <25" },
  "prometheus": { "openCodeMajorVersion": 2, "minimumOpenCodeVersion": "2.2.1" },
  "exports": { ".": "./index.mjs" },
  "files": ["index.mjs", "src/", "qualification/", "README.md"],
  "scripts": {
    "test": "node --test --test-concurrency=2 test/*.test.mjs",
    "test:native": "node --test test/native/*.test.mjs",
    "qualify": "node qualification/run.mjs",
    "qualification:catalog": "node qualification/catalog.mjs"
  },
  "dependencies": { "@opencode/plugin": "2.2.1", "@opencode/client": "2.2.1" }
}
